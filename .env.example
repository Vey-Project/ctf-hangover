# 9Router endpoint
NINEROUTER_BASE_URL=http://192.168.0.78:20128/v1
NINEROUTER_API_KEY=sk-your-9router-key

# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_token

# Model roster (comma-separated). Leave empty to auto-discover from /v1/models.
NINEROUTER_MODELS=gpt-5.4,gpt-5.4-mini,claude-opus-4-6,gemini-3-flash-preview

# Coordinator model (from 9Router roster)
COORDINATOR_MODEL=gpt-5.4

# Overkill knobs
MAX_PARALLEL_SWARMS=8
MAX_MODELS_PER_SWARM=4
SWARM_STUCK_MINUTES=5
SWARM_MAX_MINUTES=30
SWARM_MAX_TOKENS=500000
ENABLE_SELFPLAY=1
ENABLE_AUTO_DECOMPOSE=1
ENABLE_SMART_ROUTING=1
